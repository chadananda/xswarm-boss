# Omarchy Defender - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# Run: node scripts/validate-keys.js to test all keys
# ============================================================

# ============================================================
# CLOUDFLARE CONFIGURATION
# ============================================================
# Used for: Cloudflare Pages deployment and R2 asset storage
# Get these from: https://dash.cloudflare.com/
#   1. Click your profile (top right) > My Profile > API Tokens
#   2. Create a custom token with:
#      - Pages: Edit permission
#      - R2 Storage: Edit permission
#   3. Account ID is shown on the main dashboard

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 S3-compatible credentials (for asset uploads)
# Get from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================================
# ELEVENLABS VOICE GENERATION
# ============================================================
# Used for: Generating 200+ commander voice lines
# Get from: https://elevenlabs.io/app/settings > API Keys
# IMPORTANT: Generate key with ALL permissions (including user_read)
# Note: Free tier gives ~10,000 characters/month
#       Starter ($5/mo) gives 30,000 characters
#       We need ~295 voice files, plan for Starter tier

ELEVENLABS_API_KEY=

# ============================================================
# GOOGLE GEMINI AI
# ============================================================
# Used for: Asset validation, note moderation, development utilities
# Get from: https://aistudio.google.com/app/apikey
#   1. Sign in with Google account
#   2. Click "Create API Key"
#   3. Select or create a Google Cloud project
# Note: Gemini 2.0 Flash has generous free tier
#       Used for development utilities and content moderation

GEMINI_API_KEY=

# ============================================================
# STRIPE PAYMENT PROCESSING
# ============================================================
# Used for: Donation processing
# Get from: https://dashboard.stripe.com/apikeys
#
# IMPORTANT:
#   - Publishable key starts with pk_test_ or pk_live_
#   - Secret key starts with sk_test_ or sk_live_
#   - Use TEST keys during development!
#   - Switch to LIVE keys only for production
#
# For webhook secret:
#   1. Go to Developers > Webhooks
#   2. Add endpoint: https://xswarm.ai/omarchy-defender/api/webhook
#   3. Select event: checkout.session.completed
#   4. Copy the signing secret (starts with whsec_)

# Publishable key (safe to expose to frontend) - MUST start with pk_
STRIPE_PUBLISHABLE_KEY=pk_test_

# Secret key (NEVER expose in frontend code) - MUST start with sk_
STRIPE_SECRET_KEY=sk_test_

# Webhook signing secret (for verifying webhook events)
STRIPE_WEBHOOK_SECRET=whsec_

# ============================================================
# TURSO DATABASE (libSQL)
# ============================================================
# Used for: Storing donations, notes, and email list
# Get from: https://turso.tech/
#   1. Sign up at turso.tech
#   2. Create a new database (e.g., "omarchy-defender")
#   3. Go to database settings to get:
#      - Database URL (libsql://xxx.turso.io)
#      - Auth token (generate a new one with read/write access)
# Note: Free tier includes 500 databases, 9GB storage

TURSO_DATABASE_URL=libsql://
TURSO_AUTH_TOKEN=

# ============================================================
# SENDGRID EMAIL
# ============================================================
# Used for: Sending thank-you emails and project updates
# Get from: https://app.sendgrid.com/settings/api_keys
#   1. Create an API key with "Mail Send" permissions
#   2. Key starts with SG.

SENDGRID_API_KEY=SG.

# ============================================================
# LLM API KEYS (for AI-powered features)
# ============================================================
# Used for: Content moderation, asset review, intelligent features
# Primary: Anthropic or Gemini for moderation
# Optional: Others for fallback or specific use cases

# Anthropic (Claude) - Primary for content moderation
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-

# OpenAI - Optional, for future features
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-

# Perplexity - Optional, for research features
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-

# Mistral - Optional, for alternative AI features
# Get from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# ============================================================
# OPTIONAL: SUPABASE (Phase 2 - Leaderboard)
# ============================================================
# Used for: User authentication and leaderboard (future feature)
# NOT REQUIRED for initial release
# Get from: https://app.supabase.com/project/_/settings/api

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# ============================================================
# VALIDATION & TESTING
# ============================================================
# Run: node scripts/validate-keys.js
#
# This will test each API key and report any issues.
#
# For Stripe testing:
#   - Test card: 4242 4242 4242 4242
#   - Any future expiry, any 3-digit CVC, any postal code
#
# ============================================================

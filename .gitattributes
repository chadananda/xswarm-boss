# Git LFS file tracking for xSwarm
# Large files stored in Cloudflare R2 via custom LFS server
# ============================================
# Model Weights & Checkpoints
# ============================================
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text
# ============================================
# Theme Assets & Media
# ============================================
*.apng filter=lfs diff=lfs merge=lfs -text
packages/personas/**/*.wav filter=lfs diff=lfs merge=lfs -text
packages/personas/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
packages/personas/**/*.m4a filter=lfs diff=lfs merge=lfs -text
packages/personas/**/*.flac filter=lfs diff=lfs merge=lfs -text
packages/personas/**/*.ogg filter=lfs diff=lfs merge=lfs -text
# ============================================
# Compiled Binaries (>10MB threshold)

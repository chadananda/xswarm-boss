# Only track large release binaries if needed
# *.dylib filter=lfs diff=lfs merge=lfs -text
# *.so filter=lfs diff=lfs merge=lfs -text
# *.dll filter=lfs diff=lfs merge=lfs -text
# ============================================
# Embeddings & Vector Databases
# ============================================
*.faiss filter=lfs diff=lfs merge=lfs -text
*.index filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
# ============================================
# Archives (if committing large assets)
# ============================================
# *.tar.gz filter=lfs diff=lfs merge=lfs -text
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.7z filter=lfs diff=lfs merge=lfs -text
# ============================================
# Large Data Files
# ============================================
*.parquet filter=lfs diff=lfs merge=lfs -text
*.arrow filter=lfs diff=lfs merge=lfs -text
# ============================================
# LFS Exceptions
# ============================================
# Exclude test fixtures and small example files.
# .gitattributes has no negative PATTERNS — git ignores a line starting with `!` and warns
# on every command. Unsetting the attributes for the path is the supported way to opt out,
# so these read `!filter !diff !merge` (attribute unspecified) instead of `!path`.
# Only *.bin is caught by a wider LFS rule; the two audio lines document intent, since
# *.wav/*.mp3 are tracked solely under packages/personas/**.
tests/fixtures/**/*.wav !filter !diff !merge text
tests/fixtures/**/*.mp3 !filter !diff !merge text
examples/**/*.bin !filter !diff !merge text
# ============================================
# Notes
# ============================================
# - LFS pointers are small text files (~100 bytes)
# - Actual files stored in R2: s3://bucket/lfs/objects/<sha256>
# - Clone is fast (downloads pointers only)
# - `git lfs pull` downloads actual files when needed
# - Configure endpoint in .lfsconfig (read-only) and .git/config (read-write)

{
  "name": "@xswarm/server",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers webhook server for xSwarm multi-channel communication",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node scripts/sync-config.js",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --test src/simple-index.test.js",
    "test:db": "node test-database.js",
    "setup-db": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --reset --sample",
    "db:sample": "node scripts/setup-db.js --sample"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@noble/hashes": "^2.4.0",
    "chrono-node": "^2.10.1",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.1.1",
    "jsonwebtoken": "^9.0.3",
    "node-ical": "^0.27.1",
    "stripe": "^22.6.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  },
  "keywords": [
    "cloudflare-workers",
    "webhooks",
    "twilio",
    "stripe",
    "serverless"
  ]
}

{
  "name": "xswarm-boss",
  "version": "0.5.30",
  "private": true,
  "description": "AI Orchestration Layer for Multi-Project Development",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "clean": "pnpm -r run clean",
    "gate": "GATE_BASE_URL=https://xswarm-signup.pages.dev node \"$HOME/.claude/quality/gate.mjs\" --project \"$PWD\"",
    "gate:accept": "GATE_BASE_URL=https://xswarm-signup.pages.dev node \"$HOME/.claude/quality/gate.mjs\" --project \"$PWD\" --accept",
    "gate:fast": "GATE_BASE_URL=https://xswarm-signup.pages.dev node \"$HOME/.claude/quality/gate.mjs\" --project \"$PWD\" --fast",
    "test": "node tests/test-runner.js",
    "test:unit": "node tests/test-runner.js --filter=unit",
    "test:verbose": "node tests/test-runner.js --verbose",
    "dev:server": "pnpm --filter @xswarm/server run dev",
    "predeploy:server": "GATE_BASE_URL=https://xswarm-signup.pages.dev node \"$HOME/.claude/quality/gate.mjs\" --project \"$PWD\"",
    "deploy:server": "pnpm --filter @xswarm/server run deploy",
    "predeploy:admin": "GATE_BASE_URL=https://xswarm-signup.pages.dev node \"$HOME/.claude/quality/gate.mjs\" --project \"$PWD\"",
    "deploy:admin": "source .env && cd packages/server/public && npx wrangler pages deploy . --project-name xswarm-signup --commit-dirty=true",
    "predeploy:prod": "GATE_BASE_URL=https://xswarm-signup.pages.dev node \"$HOME/.claude/quality/gate.mjs\" --project \"$PWD\"",
    "deploy:prod": "node deployment/scripts/deploy-production.js --env=production",
    "deploy:check": "node deployment/scripts/pre-deploy-check.js",
    "deploy:migrate": "node deployment/scripts/migrate-all.js",
    "deploy:verify": "node deployment/scripts/verify-deployment.js",
    "deploy:rollback": "node deployment/scripts/rollback.js",
    "deploy:list": "node deployment/scripts/rollback.js --list"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.4.2",
    "smol-toml": "^1.8.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "ai",
    "orchestration",
    "voice-assistant",
    "rust",
    "developer-tools"
  ],
  "author": "xSwarm Contributors <hello@xswarm.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xswarm-dev/xswarm-boss.git"
  },
  "bugs": {
    "url": "https://github.com/xswarm-dev/xswarm-boss/issues",
    "email": "hello@xswarm.dev"
  },
  "homepage": "https://xswarm.dev"
}
